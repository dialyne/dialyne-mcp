{
  "name": "Dialyne - call a French number and wait for the result",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger",
      "name": "When clicking 'Execute workflow'",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "phone_number",
              "value": "+33534001122",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "task",
              "value": "Book a table for 4 on Friday around 8 pm for Martin. 7:30-9 pm is fine.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "input",
      "name": "Call details",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.dialyne.com/v1/missions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ $execution.id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ numero: $json.phone_number, mission: $json.task }) }}"
      },
      "id": "start-call",
      "name": "Start call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Dialyne API key"
        }
      }
    },
    {
      "parameters": {
        "amount": 20
      },
      "id": "wait",
      "name": "Wait 20 s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        660,
        0
      ],
      "webhookId": "dialyne-wait"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.dialyne.com/v1/missions/{{ $('Start call').item.json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "get-call-status",
      "name": "Get call status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Dialyne API key"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ ['terminee', 'annulee', 'erreur'].includes($json.statut) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "done",
      "name": "Finished?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "r1",
              "name": "result",
              "value": "={{ $json.resultat }}",
              "type": "string"
            },
            {
              "id": "r2",
              "name": "summary",
              "value": "={{ $json.resume }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "result",
      "name": "Result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1320,
        -100
      ]
    }
  ],
  "connections": {
    "When clicking 'Execute workflow'": {
      "main": [
        [
          {
            "node": "Call details",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call details": {
      "main": [
        [
          {
            "node": "Start call",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Start call": {
      "main": [
        [
          {
            "node": "Wait 20 s",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 20 s": {
      "main": [
        [
          {
            "node": "Get call status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get call status": {
      "main": [
        [
          {
            "node": "Finished?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Finished?": {
      "main": [
        [
          {
            "node": "Result",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait 20 s",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
